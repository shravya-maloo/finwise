# Postgres connection string. Needs the pgvector extension available, which
# every Neon project supports (CREATE EXTENSION IF NOT EXISTS vector; the app
# runs this automatically on first request, no manual step needed).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# One key covers both embeddings and generation, genuinely free (no card
# required) on the Flash models this app uses. Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
