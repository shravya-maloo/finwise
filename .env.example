# Postgres connection string. Needs the pgvector extension available, which
# every Neon project supports (CREATE EXTENSION IF NOT EXISTS vector; the app
# runs this automatically on first request, no manual step needed).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# One key covers both embeddings and generation. Free trial key (no card
# required) generated automatically when you sign up at
# https://dashboard.cohere.com
COHERE_API_KEY=your_key_here
